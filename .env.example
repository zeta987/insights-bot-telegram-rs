# =============================================================================
# Telegram Bot (required)
# Obtain token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Optional Bot API base; defaults to https://api.telegram.org and is shared by
# teloxide and Rich Message delivery. It must be an absolute HTTP(S) URL.
# TELEGRAM_BOT_API_ENDPOINT=https://api.telegram.org

# Optional: webhook mode (otherwise uses long polling)
# TELEGRAM_BOT_WEBHOOK_URL=https://your.domain/telegram_bot
# TELEGRAM_BOT_WEBHOOK_PORT=9487

# =============================================================================
# Database
# Primary: PostgreSQL (recommended for production)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Alternative env name supported by config (Go legacy)
# DB_CONNECTION_STR=postgresql://user:password@host:5432/dbname

# Fallback: SQLite file (used when Postgres is absent or unreachable)
# Leave empty or unset to use default: data/dev.db
# SQLITE_PATH=data/dev.db

# =============================================================================
# Redis recap state
# REDIS_HOST defaults to localhost when empty or unset.
# REDIS_PORT is required and must be in 1..=65535.
REDIS_PORT=6379
# REDIS_HOST=localhost
# REDIS_TLS_ENABLED=false
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_CLIENT_CACHE_ENABLED=false

# Manual recap limits; seconds, with invalid or negative values treated as 0.
# HARD_LIMIT_MANUAL_RECAP_RATE_PER_SECONDS=0

# =============================================================================
# OpenAI (required)
# OPENAI_API_SECRET is canonical. OPENAI_API_KEY is read only when the
# canonical variable is absent.
OPENAI_API_SECRET=example-openai-secret
# OPENAI_API_KEY=legacy-example-openai-secret
# Optional relay / proxy host, e.g. https://openai.example.com
# OPENAI_API_HOST=
# Detailed model defaults to gpt-3.5-turbo; backups are comma-separated.
# OPENAI_API_MODEL_NAME=gpt-3.5-turbo
# OPENAI_API_MODEL_NAME_backup=
# Total recap input budget defaults to 4096 and reserve defaults to 2000.
# Their difference must stay strictly positive.
# OPENAI_API_TOKEN_LIMIT=4096
# OPENAI_API_CHAT_HISTORIES_RECAP_TOKEN_LIMIT=2000

# =============================================================================
# Sarcastic Condensed Summary (optional customization)
# Separate model for condensed summary; falls back to OPENAI_API_MODEL_NAME if unset.
# SARCASTIC_CONDENSED_MODEL_NAME=
# SARCASTIC_CONDENSED_MODEL_NAME_backup=
# Custom system prompt for condensed summary (leave blank to use built-in default)
SARCASTIC_CONDENSED_SYSTEM_PROMPT=
# Custom user prompt template supports the Go-template syntax used by recap,
# including {{ .ChatHistory }}, printf actions, and comments. Leave blank for
# the pinned default.
SARCASTIC_CONDENSED_USER_PROMPT=
# Language for chat history summarization (default: Simplified Chinese)
CHAT_HISTORIES_SUMMARIZATION_LANGUAGE=Simplified Chinese

# =============================================================================
# Check / Format Verification Model (optional)
# Repairs malformed condensed or segmented AI outputs
# CHECK_MODEL=gpt-5.4-xhigh
# CHECK_MODEL_backup=gpt-5.1
# Test-only switches accept only true or 1. Verbose logs remain metadata-only.
# OPENAI_FORCE_CHECK_MODEL_FAILURE=false
# OPENAI_FORCE_CONDENSED_PRIMARY_FAILURE_FOR_TEST=false
# OPENAI_VERBOSE_PAYLOAD_LOGS=false

# Scheduler time is shifted by this many seconds. Invalid values use 0.
# TIMEZONE_SHIFT_SECONDS=0
# When enabled with a nonzero chat ID, startup also queues one immediate recap.
# AUTO_RECAP_TEST_ENABLED=false
# AUTO_RECAP_TEST_CHAT_ID=0

# =============================================================================
# Health & lifecycle
# Port for the composite /health readiness endpoint. Defaults to Go's 7069
# and must be in 1..=65535; an invalid value fails startup.
# HEALTH_HTTP_PORT=7069

# =============================================================================
# Localization & Logging
# Default locale: en (options: en | zh-Hans | zh-Hant)
INSIGHTS_LANG=en
# Path to locales folder
# LOCALES_DIR=./locales
# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
# Log file path (optional, logs to stdout if unset)
# LOG_FILE_PATH=./logs/insights-bot.log
